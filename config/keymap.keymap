#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define SCROLL_LAYER 4
#define AML_LAYER 1 /* オートマウスレイヤー＝layer_1（トラボを動かすと自動で乗る） */

&pointing_listener {
    /* 親の input-processors はシールド側(torabo_tsuki_lp_right.overlay)の指定を
       そのまま引き継いだうえで、末尾に zip_temp_layer を足している。
       <レイヤー番号 滞留ms> = トラボが止まってから5秒でAMLが剥がれる。 */
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_temp_layer AML_LAYER 5000>;

    /* K長押し(SCROLL_LAYER)中はこちらがマッチして、上の input-processors は走らない。
       ＝スクロール中にAMLが誤発動することもない。 */
    scroll {
        layers = <SCROLL_LAYER>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 8>;
    };
};

&zip_temp_layer {
    /* 直前のキー入力から何ms以内ならAMLに入らないか。タイピング中の誤爆防止。 */
    require-prior-idle-ms = <350>;

    /* AMLを「解除しない」キー位置のリスト。
       ここに載っていないキーを押すと即座に AML_LAYER が剥がれる。
       layer_1 で &trans 以外にした位置は、原則すべてここに並べること。
       （除外位置を押しても5秒のタイマーは延長されない。延長されるのはトラボ操作のみ） */
    excluded-positions = <
        20  /* row1: I → &mkp MCLK */
        33  /* row2: J → &mkp LCLK */
        34  /* row2: K → AMLでは &trans。除外しておくと、AMLを保ったまま
               layer_0 の &lt SCROLL_LAYER K でスクロールに入れる */
        35  /* row2: L → &mkp RCLK */

        53  /* row4: LCMD  ┐ */
        54  /* row4: LALT  │ 修飾キーは除外。cmd+クリック / shift+クリックの途中で */
        55  /* row4: LCTRL │ AMLが剥がれてクリックがただの文字入力になるのを防ぐ */
        58  /* row4: &mt LEFT_SHIFT LANG2 ┘ */
        57  /* row4: &mkp LCLK（親指クリック）。押してもAMLを維持したいので除外 */
    >;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        COMBO_ESC {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <26 25>;
        };

        COMBO_LCLK {
            bindings = <&mkp LCLK>;
            key-positions = <33 34>;
        };
    };

    macros {
        korean: korean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LC(LA(SPACE))>;
            label = "KOREAN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans    &trans        &trans     &trans         &trans                                                  &trans       &trans  &trans              &trans               &trans       &trans
&trans  &kp Q     &kp W         &kp E      &kp R          &kp T                                                   &kp Y        &kp U   &kp I               &kp O                &kp P        &trans
&trans  &kp A     &kp S         &kp D      &kp F          &kp G      &trans                     &trans            &kp H        &kp J   &lt SCROLL_LAYER K  &kp L                &lt 1 ENTER  &trans
&trans  &kp Z     &kp X         &kp C      &kp V          &kp B      &kp LC(UP_ARROW)           &korean           &kp N        &kp M   &kp COMMA           &kp DOT              &kp MINUS    &trans
&trans  &kp LCMD  &kp LEFT_ALT  &kp LCTRL  &kp BACKSPACE  &mkp LCLK  &mt LEFT_SHIFT LANGUAGE_2  &lt 2 LANGUAGE_1  &lt 3 SPACE  &trans  &trans              &kp C_VOICE_COMMAND  &kp SLASH    &trans
            >;
        };

        /* マウスレイヤー。Enter長押し(&lt 1 ENTER)で手動、
           トラボを動かすと zip_temp_layer で自動（AML）でも乗る。
           中クリックは I(pos 20)。K(pos 34) は &trans のまま
           ＝AML中でもK長押しでスクロールに入れるため。
           ここを &trans 以外にしたら excluded-positions にも位置番号を足すこと。 */

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans                     &trans          &trans         &trans            &trans             &trans         &trans
&trans  &trans  &kp N7  &kp N8  &kp N9      &kp N0                     &kp LS(N6)      &kp LS(N7)     &kp LS(N8)        &kp LS(N9)         &kp LS(N0)     &trans
&trans  &trans  &kp N4  &kp N5  &kp N6      &kp PLUS   &trans  &trans  &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON      &trans
&trans  &kp N0  &kp N1  &kp N2  &kp N3      &kp MINUS  &trans  &trans  &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans  &trans  &trans  &trans  &kp DELETE  &trans     &trans  &trans  &kp DELETE      &trans         &trans            &trans             &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans        &trans        &trans      &trans         &trans                   &trans           &trans                  &trans          &trans                   &trans         &trans
&trans  &kp F1        &kp F2        &kp F3      &kp F4         &kp F5                   &kp LG(R)        &kp LG(LA(LEFT_ARROW))  &kp UP_ARROW    &kp LA(LG(RIGHT_ARROW))  &kp LG(T)      &trans
&trans  &kp F6        &kp F7        &kp F8      &kp F9         &kp F10  &trans  &trans  &kp EXCLAMATION  &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT                &kp LG(W)      &trans
&trans  &kp F11       &kp F12       &kp LG(C)   &kp LG(LS(V))  &trans   &trans  &trans  &kp QUESTION     &mkp MB4                &kp LG(M)       &mkp MB5                 &kp LS(LG(T))  &trans
&trans  &out OUT_USB  &out OUT_USB  &bt BT_NXT  &kp DELETE     &kp TAB  &trans  &trans  &trans           &trans                  &trans          &kp LG(MINUS)            &kp LG(EQUAL)  &trans
            >;
        };

        layer_scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
